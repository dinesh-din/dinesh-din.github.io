---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date } = entry.data;
const when = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={title} description={summary}>
  <article class="project-page">
    <div class="wrap">
      <a class="back" href="/notes/">← All notes</a>
      <h1>{title}</h1>
      <p class="summary">{when}</p>
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>