---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const statusLabel = { shipped: 'Shipped', 'in-progress': 'In progress', planned: 'Planned' } as const;
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{site.role}</p>
        <h1>Hi, I'm {site.name}.</h1>
        <p class="lead">{site.tagline}</p>
        <div class="cta">
          <a class="btn primary" href="#projects">See my work</a>
          <a class="btn" href="#contact">Get in touch</a>
        </div>
      </div>
      {site.photo && (
        <img class="avatar" src={site.photo} alt={`Photo of ${site.name}`} width="220" height="220" />
      )}
    </div>
  </section>

  <section id="about" class="about">
    <div class="wrap">
      <h2>About</h2>
      {site.about.map((p) => <p>{p}</p>)}
      {site.location && <p class="facts">Based in {site.location}</p>}
    </div>
  </section>

  {site.experience.length > 0 && (
    <section id="experience">
      <div class="wrap">
        <h2>Experience</h2>
        <div class="timeline">
          {site.experience.map((job) => (
            <div class="job">
              <div class="job-head">
                <h3>{job.role} · {job.company}</h3>
                <span class="period">{job.period}</span>
              </div>
              <ul>
                {job.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="projects">
    <div class="wrap">
      <h2>Projects</h2>
      <div class="grid">
        {projects.map((p) => (
          <a class="card" href={`/projects/${p.id}/`}>
            {p.data.image && <img class="card-img" src={p.data.image} alt="" loading="lazy" />}
            <span class="status">{statusLabel[p.data.status]}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <div class="tags">
              {p.data.stack.map((s) => <span class="tag">{s}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="skills">
    <div class="wrap">
      <h2>Skills</h2>
      <div class="skills">
        {Object.entries(site.skills).map(([group, items]) => (
          <div>
            <h3>{group}</h3>
            <div class="tags">
              {items.map((s) => <span class="tag">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <h2>Contact</h2>
      {site.email ? (
        <p>
          The best way to reach me is <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      ) : (
        <p>The best way to reach me right now is through GitHub.</p>
      )}
      <p>
        <a href={site.links.github}>GitHub</a>
        {site.links.linkedin && <> · <a href={site.links.linkedin}>LinkedIn</a></>}
      </p>
    </div>
  </section>
</Base>
