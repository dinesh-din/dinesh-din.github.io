---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import SkillsExplorer from '../components/SkillsExplorer.astro';
import Buddy from '../components/Buddy.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';
import { extras } from '../extras';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Fall back to sensible defaults if extras.ts is an older copy without these lists.
type Item = { big: string; text: string };
const valid = (list: unknown): Item[] =>
  Array.isArray(list) ? (list as Item[]).filter((i) => i && typeof i.big === 'string' && typeof i.text === 'string') : [];
const pharmaItems: Item[] = valid(extras.stats).length
  ? valid(extras.stats)
  : [{ big: '99.9%', text: 'Uptime on PharmaConnect, with 92% test coverage' }];
const endToEnd: Item[] = valid((extras as { endToEnd?: unknown }).endToEnd).length
  ? valid((extras as { endToEnd?: unknown }).endToEnd)
  : [{ big: 'Schema to cloud', text: 'Database, API, UI and deployment, end to end' }];
const projectItems = projects.map((p, i) => ({ big: `${i + 1} of ${projects.length}`, text: p.data.title }));
const facts = extras.funFacts || [];
const building = projects.filter((p) => p.data.status === 'in-progress');
const achievements = extras.achievements || [];
const testimonials = extras.testimonials || [];
const formspree = extras.formspree || '';
// mailto: does nothing on computers with no mail app, so Gmail addresses open Gmail's compose window instead.
const isGmail = /@(gmail|googlemail)\.com$/i.test(site.email || '');
const writeHref = isGmail
  ? `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}&su=${encodeURIComponent('Hello from your portfolio')}`
  : `mailto:${site.email}`;
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{site.role}</p>
        <h1>Hi, I'm {site.name}.</h1>
        <p class="rotator-line">
          I build <span class="rotator" data-words={JSON.stringify(extras.roles)}>{extras.roles[0]}</span><span class="caret" aria-hidden="true"></span>
        </p>
        <p class="lead">{site.tagline}</p>
        <div class="cta">
          <a class="btn primary" href="#projects">See my projects</a>
          <a class="btn" href="#contact">Get in touch</a>
          {site.resume && <a class="btn" href={site.resume} target="_blank" rel="noopener">Resume</a>}
        </div>
        <div class="tags hero-tags">
          {site.highlights.map((h) => <span class="tag">{h}</span>)}
        </div>
        {building.length > 0 && (
          <a class="building" href="#projects">
            <span class="pulse" aria-hidden="true"></span>
            <span><strong>Currently building:</strong> {building.map((b) => b.data.title).join(' and ')}</span>
          </a>
        )}
      </div>
      <Avatar />
    </div>
  </section>

  <section class="stats" aria-label="Highlights">
    <div class="wrap">
      <div class="stat-grid">
        <div class="stat rot-tile" data-items={JSON.stringify(pharmaItems)} data-interval="5000">
          <div class="stat-value rot-big">{pharmaItems[0].big}</div>
          <div class="stat-label rot-text">{pharmaItems[0].text}</div>
        </div>
        <a class="stat proj-tile" href="#projects" data-items={JSON.stringify(projectItems)} data-total={projects.length} title="See the projects">
          <span class="stat-value proj-big">{projects.length}</span>
          <span class="stat-label proj-text">Personal projects</span>
        </a>
        <div class="stat rot-tile" data-items={JSON.stringify(endToEnd)} data-interval="7000">
          <div class="stat-value stat-words rot-big">{endToEnd[0].big}</div>
          <div class="stat-label rot-text">{endToEnd[0].text}</div>
        </div>
        {facts.length > 0 && (
          <button class="stat fun-tile" type="button" data-facts={JSON.stringify(facts)} title="Hover to pause, click for the next one">
            <span class="stat-value fun-big">{facts[0].big}</span>
            <span class="stat-label fun-text">{facts[0].text}</span>
          </button>
        )}
      </div>
    </div>
  </section>

  <section id="about" class="about">
    <div class="wrap">
      <h2>About</h2>
      {site.about.map((p) => <p>{p}</p>)}
      {site.location && <p class="facts">Based in {site.location}</p>}
    </div>
  </section>

  {(achievements.length > 0 || testimonials.length > 0) && (
    <section id="recognition">
      <div class="wrap">
        <h2>Recognition</h2>
        {achievements.length > 0 && (
          <div class="badges">
            {achievements.map((a) => (
              <div class="badge-card">
                <strong>{a.title}</strong>
                <span>{a.detail}</span>
              </div>
            ))}
          </div>
        )}
        {testimonials.length > 0 && (
          <div class="quotes">
            {testimonials.map((t) => (
              <figure class="quote">
                <blockquote>{t.quote}</blockquote>
                <figcaption><strong>{t.name}</strong>, {t.role}</figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {site.experience.length > 0 && (
    <section id="experience">
      <div class="wrap">
        <h2>Experience</h2>
        <div class="timeline">
          {site.experience.map((job) => (
            <div class="job">
              <div class="job-head">
                <h3>{job.role} · {job.company}</h3>
                <span class="period">{job.period}</span>
              </div>
              <ul>
                {job.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="projects">
    <div class="wrap">
      <h2>{site.projectsTitle}</h2>
      <p class="section-intro">{site.projectsIntro}</p>
      <ProjectShowcase projects={projects} />
    </div>
  </section>

  <section id="skills">
    <div class="wrap">
      <h2>Skills</h2>
      <SkillsExplorer />
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <h2>Contact</h2>
      <p class="section-intro">Have a role, a project or a question? Say hello.</p>
      <div class="contact-actions">
        {site.email && (
          <button class="btn primary" type="button" id="copy-email" data-email={site.email}>Copy email</button>
        )}
        {site.email && <a class="btn" href={writeHref} target={isGmail ? '_blank' : undefined} rel={isGmail ? 'noopener' : undefined}>Write an email</a>}
        {site.links.linkedin && <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        <a class="btn" href={site.links.github} target="_blank" rel="noopener">GitHub</a>
      </div>
      {site.email && <p class="contact-email">{site.email} <span id="copy-note" role="status"></span></p>}

      {formspree && (
        <form class="contact-form" id="contact-form" action={`https://formspree.io/f/${formspree}`} method="POST">
          <label>Your name<input name="name" required autocomplete="name" /></label>
          <label>Your email<input name="email" type="email" required autocomplete="email" /></label>
          <label>Message<textarea name="message" rows="4" required></textarea></label>
          <button class="btn primary" type="submit">Send message</button>
          <p id="form-note" role="status"></p>
        </form>
      )}
    </div>
  </section>

  <Buddy />
</Base>

<script>
  // Tiles that change by themselves: the PharmaConnect tile and the "Schema to cloud" tile.
  document.querySelectorAll<HTMLElement>('.rot-tile').forEach((tile) => {
    let items: { big: string; text: string }[] = [];
    try { items = JSON.parse(tile.dataset.items || '[]'); } catch { items = []; }
    const big = tile.querySelector<HTMLElement>('.rot-big');
    const text = tile.querySelector<HTMLElement>('.rot-text');
    if (items.length < 2 || !big || !text) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = 0;
    let paused = false;
    const next = () => {
      at = (at + 1) % items.length;
      const paint = () => { big.textContent = items[at].big; text.textContent = items[at].text; };
      if (reduce) { paint(); return; }
      tile.classList.add('swap');
      window.setTimeout(() => { paint(); tile.classList.remove('swap'); }, 220);
    };
    tile.addEventListener('mouseenter', () => { paused = true; });
    tile.addEventListener('mouseleave', () => { paused = false; });
    window.setInterval(() => { if (!paused && !document.hidden) next(); }, Number(tile.dataset.interval) || 6000);
  });
</script>

<script>
  // "5 Personal projects" tile: steps through each project, then goes back to the total.
  const projTile = document.querySelector<HTMLElement>('.proj-tile');
  if (projTile) {
    let items: { big: string; text: string }[] = [];
    try { items = JSON.parse(projTile.dataset.items || '[]'); } catch { items = []; }
    const pBig = projTile.querySelector<HTMLElement>('.proj-big');
    const pText = projTile.querySelector<HTMLElement>('.proj-text');
    if (items.length > 1 && pBig && pText) {
      const reduceP = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const states = [{ big: projTile.dataset.total || String(items.length), text: 'Personal projects' }, ...items];
      let at = 0;
      let pausedP = false;
      const paintP = (st: { big: string; text: string }) => { pBig.textContent = st.big; pText.textContent = st.text; };
      const advance = () => {
        at = (at + 1) % states.length;
        if (reduceP) { paintP(states[at]); return; }
        projTile.classList.add('swap');
        window.setTimeout(() => { paintP(states[at]); projTile.classList.remove('swap'); }, 220);
      };
      projTile.addEventListener('mouseenter', () => { pausedP = true; });
      projTile.addEventListener('mouseleave', () => { pausedP = false; });
      projTile.addEventListener('focus', () => { pausedP = true; });
      projTile.addEventListener('blur', () => { pausedP = false; });
      window.setInterval(() => { if (!pausedP && !document.hidden) advance(); }, 3500);
    }
  }
</script>

<script>
  const tile = document.querySelector<HTMLElement>('.fun-tile');
  if (tile) {
    let facts: { big: string; text: string }[] = [];
    try { facts = JSON.parse(tile.dataset.facts || '[]'); } catch { facts = []; }
    const big = tile.querySelector<HTMLElement>('.fun-big');
    const text = tile.querySelector<HTMLElement>('.fun-text');
    if (facts.length > 1 && big && text) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Shuffle once so every fact gets its turn before any repeats.
      const order = facts.map((_, i) => i).sort(() => Math.random() - 0.5);
      let pos = 0;
      try {
        const last = Number(sessionStorage.getItem('fact') ?? -1);
        if (order[0] === last) order.push(order.shift() as number); // do not open on the same fact as last visit
      } catch {}

      const paint = (i: number) => {
        big.textContent = facts[i].big;
        text.textContent = facts[i].text;
        try { sessionStorage.setItem('fact', String(i)); } catch {}
      };
      const show = (i: number) => {
        if (reduce) { paint(i); return; }
        tile.classList.add('swap');
        window.setTimeout(() => { paint(i); tile.classList.remove('swap'); }, 220);
      };
      const next = () => {
        pos = (pos + 1) % order.length;
        show(order[pos]);
      };

      paint(order[0]);

      // Change by itself every 6 seconds; pause while the visitor is pointing at it or the tab is hidden.
      let timer: number | undefined;
      let paused = false;
      const start = () => {
        window.clearInterval(timer);
        timer = window.setInterval(() => { if (!paused && !document.hidden) next(); }, 6000);
      };
      tile.addEventListener('mouseenter', () => { paused = true; });
      tile.addEventListener('mouseleave', () => { paused = false; });
      tile.addEventListener('focus', () => { paused = true; });
      tile.addEventListener('blur', () => { paused = false; });
      tile.addEventListener('click', () => { next(); start(); }); // clicking still skips ahead
      start();
    }
  }
</script>

<script>
  // Copy email button
  const copyBtn = document.getElementById('copy-email');
  const copyNote = document.getElementById('copy-note');
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email || '';
    try {
      await navigator.clipboard.writeText(email);
      if (copyNote) copyNote.textContent = 'Copied!';
      window.dispatchEvent(new CustomEvent('buddy:say', { detail: { text: 'Email copied. Talk soon!', found: true, ms: 3000 } }));
    } catch {
      if (copyNote) copyNote.textContent = 'Press Ctrl+C to copy it.';
    }
    window.setTimeout(() => { if (copyNote) copyNote.textContent = ''; }, 2500);
  });

  // Contact form (Formspree) without leaving the page
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const note = document.getElementById('form-note');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (note) note.textContent = 'Sending...';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (res.ok) {
        form.reset();
        if (note) note.textContent = 'Thanks! Your message is on its way.';
        window.dispatchEvent(new CustomEvent('buddy:say', { detail: { text: 'Message sent!', found: true, ms: 3500 } }));
      } else if (note) note.textContent = 'Something went wrong. Please try again or use the email button.';
    } catch {
      if (note) note.textContent = 'Could not send. Please check your connection and try again.';
    }
  });
</script>