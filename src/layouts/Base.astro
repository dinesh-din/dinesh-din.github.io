---
import '../styles/global.css';
import '../styles/interactive.css';
import '../styles/vibrant.css';
import { site } from '../site';
import { extras } from '../extras';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const notes = (await getCollection('notes')).filter((n) => !n.data.draft);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://dinesh-din.github.io').href;
const ogImage = new URL('/og.png', Astro.site ?? 'https://dinesh-din.github.io').href;
const gc = (extras as { goatcounter?: string }).goatcounter || '';
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {gc && <script is:inline async data-goatcounter={`https://${gc}.goatcounter.com/count`} src="//gc.zgo.at/count.js"></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      // Runs before the page paints: mark JS as available and apply a saved theme.
      document.documentElement.classList.add('js');
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.setAttribute('data-theme', saved);
        var pal = localStorage.getItem('palette');
        if (pal) document.documentElement.setAttribute('data-palette', pal);
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <div class="header-right">
          <nav class="nav">
            {site.experience.length > 0 && <a href="/#experience">Experience</a>}
            <a href="/#projects">Projects</a>
            <a href="/#skills">Skills</a>
            {notes.length > 0 && <a href="/notes/">Notes</a>}
            <a href="/#contact">Contact</a>
          </nav>
          <button class="theme-btn" id="theme-btn" type="button" aria-label="Switch between light and dark theme">◐</button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap foot">
        <span>© {new Date().getFullYear()} {site.name}. Built with Astro.</span>
        <span class="palette" role="group" aria-label="Pick a colour theme">
          <span class="palette-label">Pick a colour</span>
          <button type="button" class="pal-dot" data-pal="pop" aria-label="Pop pink" style="background:#ff3d8b"></button>
          <button type="button" class="pal-dot" data-pal="ocean" aria-label="Ocean blue" style="background:#0a84ff"></button>
          <button type="button" class="pal-dot" data-pal="sunset" aria-label="Sunset orange" style="background:#ff6a00"></button>
          <button type="button" class="pal-dot" data-pal="grape" aria-label="Grape purple" style="background:#9b3dff"></button>
          <button type="button" class="pal-dot" data-pal="forest" aria-label="Forest green" style="background:#00a86b"></button>
        </span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ----- Theme toggle -----
      const btn = document.getElementById('theme-btn');
      const currentTheme = () =>
        root.getAttribute('data-theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const paintIcon = () => {
        if (btn) btn.textContent = currentTheme() === 'dark' ? '☀' : '☾';
      };
      paintIcon();
      btn?.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch {}
        paintIcon();
      });

      // ----- Colour palette picker -----
      const pals = Array.from(document.querySelectorAll<HTMLButtonElement>('.pal-dot'));
      const markPal = () => {
        const cur = root.getAttribute('data-palette') || 'pop';
        pals.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pal === cur)));
      };
      pals.forEach((b) =>
        b.addEventListener('click', () => {
          const v = b.dataset.pal || 'pop';
          root.setAttribute('data-palette', v);
          try { localStorage.setItem('palette', v); } catch {}
          markPal();
          window.dispatchEvent(new CustomEvent('buddy:say', { detail: { text: 'Ooh, nice colour!', ms: 2600 } }));
        })
      );
      markPal();

      // ----- Count-up numbers -----
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const target = Number(el.dataset.count);
        const decimals = Number(el.dataset.decimals || 0);
        if (reduce || !('IntersectionObserver' in window) || Number.isNaN(target)) return;
        el.textContent = (0).toFixed(decimals);
        const io = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            io.disconnect();
            const start = performance.now();
            const duration = 1200;
            const step = (now: number) => {
              const p = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = (target * eased).toFixed(decimals);
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          },
          { threshold: 0.5 }
        );
        io.observe(el);
      });

      // ----- Typed line: "I build ___" -----
      const rotator = document.querySelector<HTMLElement>('.rotator');
      if (rotator && !reduce) {
        let words: string[] = [];
        try { words = JSON.parse(rotator.dataset.words || '[]'); } catch { words = []; }
        if (words.length > 1) {
          let w = 0;
          let c = words[0].length;
          let deleting = false;
          const tick = () => {
            const word = words[w];
            if (!deleting) {
              if (c < word.length) {
                c++;
                rotator.textContent = word.slice(0, c);
                window.setTimeout(tick, 55);
              } else {
                deleting = true;
                window.setTimeout(tick, 1800);
              }
            } else if (c > 0) {
              c--;
              rotator.textContent = word.slice(0, c);
              window.setTimeout(tick, 28);
            } else {
              deleting = false;
              w = (w + 1) % words.length;
              window.setTimeout(tick, 250);
            }
          };
          window.setTimeout(tick, 2200);
        }
      }
    </script>
  </body>
</html>